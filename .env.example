# Copy this file to .env and fill it in. .env is never committed.

# ---------------------------------------------------------------------------
# Issued by BIR only after the company enrolls in EIS.
# While these are placeholders, real JSON export is refused and printed
# invoices carry a "PROTOTYPE - NOT A VALID INVOICE" watermark.
# ---------------------------------------------------------------------------
# EIS Certification / Accreditation ID: 8 chars, starts with 20 (= CAS).
EIS_CERT_NO=__PLACEHOLDER_EIS_CERT_NO__
# Permit To Use / Acknowledgment Certificate Control Number for the CAS.
PTU_NUM=__PLACEHOLDER_PTU_NUMBER__

# ---------------------------------------------------------------------------
# Company settings
# ---------------------------------------------------------------------------
# Optional seller e-mail (goes into SellerInfo.Email).
SELLER_EMAIL=

# The first control number the app hands out. Only read when the database
# is created; after that the app continues from the last number it issued.
# For real use, set it to the number after the last paper receipt used.
CONTROL_NO_START=0001773

# Where invoices, PDFs and exports are kept (relative to the project folder).
DATA_DIR=data

# ---------------------------------------------------------------------------
# Sending to BIR (phase 3). All from the EIS certification portal after
# enrollment. Leave empty until then; the app shows what is missing on its
# BIR page. Keep key files in the keys/ folder (never committed).
# ---------------------------------------------------------------------------
# Sandbox by default. Production only after BIR approves the system.
EIS_BASE_URL=https://eis-cert.bir.gov.ph
EIS_APPLICATION_ID=
EIS_APPLICATION_SECRET=
EIS_USER_ID=
EIS_PASSWORD=
# EIS key ID (sent as the JWS "kid") and the key files
EIS_KEY_ID=
EIS_PUBLIC_KEY_FILE=keys/eis_public_key.pem
EIS_PRIVATE_KEY_FILE=keys/taxpayer_private_key.pem
EIS_PRIVATE_KEY_PASSWORD=

# UNCONFIRMED: not in the spec notes. Check against the official API guide
# (section 8) or the sandbox, then adjust here (no code change needed).
# RSA padding for the login data: pkcs1v15, oaep-sha1 or oaep-sha256
EIS_RSA_PADDING=pkcs1v15
# How the login reply is decrypted with authKey (same scheme as invoice data)
EIS_AUTH_RESPONSE_CIPHER=aes-cbc-key-iv
# Timezone of the "datetime" header, hours from UTC (Philippine time = 8)
EIS_DATETIME_TZ_HOURS=8
EIS_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# E-mailing invoices to clients (SMTP). Works with Microsoft 365 / Outlook
# (smtp.office365.com, 587, starttls), Gmail / Google Workspace
# (smtp.gmail.com, 587, starttls, with an App Password) or your own server.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Micronet Software Manila, Inc.
# Copies of every invoice e-mail (comma-separated), e.g. accounting
EMAIL_CC=
EMAIL_BCC=
# true = e-mail the PDF to the client automatically when an invoice is issued
EMAIL_AUTO_SEND=false
# Recipients are typed on the invoice page (the client's e-mail is filled in).
